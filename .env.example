# ==============================================================================
# ESTUDA AI - CONFIGURAÇÃO DE AMBIENTE (v0.7)
# Copie este arquivo para .env.local e preencha com suas credenciais.
# NUNCA envie o arquivo .env ou .env.local para o repositório Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API (Recursos de IA: Simulados, Resumos, Mapas e Redações)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_api_aqui
# Modelo oficial recomendado: gemini-3.6-flash (ou gemini-3.8-flash)
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 2. SUPABASE (Autenticação Google OAuth e Banco de Questões de Vestibulares)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica_do_supabase

# ------------------------------------------------------------------------------
# 3. URL DE PRODUÇÃO (Redirecionamento OAuth na Vercel)
# Em desenvolvimento local use: http://localhost:3000
# Em produção na Vercel use o domínio da Vercel: https://seu-app.vercel.app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
